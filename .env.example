# Supabase — Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Brevo — https://app.brevo.com/settings/keys/api
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=JIJ 2026
# Optionnel : adresse où arrivent les réponses des destinataires, si différente
# de BREVO_SENDER_EMAIL.
BREVO_REPLY_TO_EMAIL=

# URL publique de l'app (utilisée dans les liens de confirmation envoyés par email)
# En local : http://localhost:3000
# En production : https://<votre-projet>.vercel.app
NEXT_PUBLIC_APP_URL=http://localhost:3000
